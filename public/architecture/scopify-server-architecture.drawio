<mxfile host="app.diagrams.net" agent="Scopify" version="22.1.0" type="device" pages="5">
  <diagram id="page-overview" name="1. Overview &amp; Tooling">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t0" value="SCOPIFY SERVER — FULL ARCHITECTURE&#xa;Region: ap-south-1 (Mumbai) · Project: scopify-cluster · Domain: ashmit.xyz&#xa;Repo: Scopify Server (Terraform IaC + Ansible config + edge TLS)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="1440" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="tool-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="110" width="1440" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="tool-title" value="HOW THE REPO IS SPLIT (who does what)" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="400" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="tf" value="&lt;b&gt;TERRAFORM — Infrastructure as Code (IaC)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Creates / destroys AWS resources&lt;br&gt;• Custom VPC 10.20.0.0/16&lt;br&gt;• Public + private subnets (2 AZs)&lt;br&gt;• IGW + NAT Gateway + route tables&lt;br&gt;• Security groups (nginx/cluster/jenkins/sonar/nexus)&lt;br&gt;• 7× EC2 instances + tags (Role, Ansible)&lt;br&gt;• Nginx Elastic IP&lt;br&gt;• IAM instance profile for SSM&lt;br&gt;• VPC endpoints (SSM + S3 gateway)&lt;br&gt;&lt;br&gt;&lt;i&gt;Path: terraform/ · apply once, then day-2 via Ansible&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="160" width="430" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="an" value="&lt;b&gt;ANSIBLE — Configuration Management&lt;/b&gt;&lt;br&gt;&lt;br&gt;Configures software ON the EC2s Terraform built&lt;br&gt;• Dynamic inventory (aws_ec2 by tags)&lt;br&gt;• site.yml → kubeadm cluster&lt;br&gt;• site-tools.yml → Jenkins / Sonar / Nexus Docker&lt;br&gt;• site-nginx.yml → edge reverse proxy + TLS&lt;br&gt;• site-ssm.yml → SSM login as ubuntu&lt;br&gt;• Roles: common, master, workers, nginx, jenkins…&lt;br&gt;&lt;br&gt;&lt;i&gt;Path: ansible/ · SSH via ProxyJump(Nginx) or SSM&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="160" width="430" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="edge" value="&lt;b&gt;EDGE / DNS / TLS&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Cloudflare DNS for ashmit.xyz&lt;br&gt;• A records → Nginx EIP&lt;br&gt;• Wildcard cert *.ashmit.xyz&lt;br&gt;  (Let’s Encrypt DNS-01 + Cloudflare API)&lt;br&gt;• Host-based routing on Nginx Docker&lt;br&gt;&lt;br&gt;Hosts today:&lt;br&gt;jenkins / sonar / nexus / test-k8s / (api later)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1020" y="160" width="470" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="flow-title" value="END-TO-END REQUEST FLOW (as-built today)" style="text;html=1;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="420" width="500" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="u1" value="User / Browser" style="rounded=1;fillColor=#E2E8F0;strokeColor=#475569;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="470" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="u2" value="Cloudflare DNS&#xa;*.ashmit.xyz → EIP" style="rounded=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="280" y="470" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="u3" value="Nginx EC2 (public)&#xa;Docker nginx · TLS · Host routing" style="rounded=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="470" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="u4" value="Private backends&#xa;Jenkins:8080 · Sonar:9000 · Nexus:8081&#xa;K8s Ingress NodePort (test apps / future api)" style="rounded=1;fillColor=#DCFCE7;strokeColor=#16A34A;" vertex="1" parent="1">
          <mxGeometry x="820" y="460" width="320" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="u5" value="Admin path&#xa;SSM Session Manager&#xa;or SSH → Nginx → ProxyJump" style="rounded=1;fillColor=#F3E8FF;strokeColor=#7C3AED;" vertex="1" parent="1">
          <mxGeometry x="1200" y="460" width="220" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="u1" target="u2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="u2" target="u3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="u3" target="u4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="legend" value="&lt;b&gt;Legend / rule of thumb&lt;/b&gt;&lt;br&gt;Blue = Terraform-owned AWS resources · Green = Ansible-configured software · Amber = DNS/TLS edge · Purple = admin access&lt;br&gt;Only Nginx has a public IP + EIP. Everything else is private (no public IP) and reaches internet via NAT." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="560" width="1440" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="pages" value="Pages → 1 Overview · 2 VPC &amp; networking · 3 EC2 roles · 4 Kubernetes bootstrap · 5 Traffic &amp; what’s inside K8s" style="text;html=1;align=center;fontSize=11;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="80" y="650" width="1440" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-vpc" name="2. VPC &amp; Networking">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="v0" value="TERRAFORM VPC ARCHITECTURE (live tfvars)" style="text;html=1;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="1440" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="v0b" value="use_custom_vpc=true · vpc_cidr=10.20.0.0/16 · az_count=2 · enable_nat_gateway=true · enable_ssm=true · S3 gateway endpoint on" style="text;html=1;align=center;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="80" y="55" width="1440" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="vpc" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=3;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="1480" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="vpc-l" value="AWS VPC — scopify-cluster-vpc · 10.20.0.0/16 · DNS hostnames/support ON" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="80" y="110" width="700" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="igw" value="Internet Gateway&#xa;(scopify-cluster-igw)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="150" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="pub" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="90" y="240" width="1420" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="pub-l" value="PUBLIC TIER — route: 0.0.0.0/0 → IGW · subnets /20 via cidrsubnet(vpc,4,i)" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="110" y="250" width="800" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="ps1" value="&lt;b&gt;Public subnet AZ-a&lt;/b&gt;&lt;br&gt;10.20.0.0/20&lt;br&gt;&lt;br&gt;• Nginx EC2 (t3.small)&lt;br&gt;• Public IP + Elastic IP&lt;br&gt;• SG: scopify-nginx-sg&lt;br&gt;  22 / 80 / 443 from world&lt;br&gt;&lt;br&gt;Role: ONLY public entry" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#FFFFFF;strokeColor=#059669;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="290" width="280" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="ps2" value="&lt;b&gt;Public subnet AZ-b&lt;/b&gt;&lt;br&gt;10.20.16.0/20&lt;br&gt;&lt;br&gt;• Spare / HA capacity&lt;br&gt;• Same public RT → IGW&lt;br&gt;&lt;br&gt;(instances today prefer AZ-a public for Nginx)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#FFFFFF;strokeColor=#059669;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="290" width="250" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="nat" value="&lt;b&gt;NAT Gateway&lt;/b&gt;&lt;br&gt;Lives in public subnet&lt;br&gt;Own EIP&lt;br&gt;&lt;br&gt;Private outbound:&#xa;apt, Docker Hub, GHCR,&#xa;kubeadm images, Helm…&#xa;&lt;br&gt;~\$32+/mo (accepted)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#FEF9C3;strokeColor=#CA8A04;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="720" y="290" width="240" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="eip" value="&lt;b&gt;Elastic IP&lt;/b&gt;&lt;br&gt;aws_eip.nginx&lt;br&gt;Attached to Nginx&lt;br&gt;&lt;br&gt;Stable DNS target for&#xa;*.ashmit.xyz" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="290" width="220" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="ssm-ep" value="&lt;b&gt;VPC Endpoints&lt;/b&gt;&lt;br&gt;SSM / ssmmessages /&#xa;ec2messages (interface)&lt;br&gt;S3 gateway endpoint&lt;br&gt;&lt;br&gt;Admin without bastion;&#xa;private pull of S3-backed&#xa;AWS APIs" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1250" y="290" width="230" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="priv" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="90" y="530" width="1420" height="440" as="geometry"/>
        </mxCell>
        <mxCell id="priv-l" value="PRIVATE TIER — no public IPs · route: 0.0.0.0/0 → NAT Gateway · inbound only from VPC / Nginx path" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#991B1B;" vertex="1" parent="1">
          <mxGeometry x="110" y="540" width="900" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="pr1" value="&lt;b&gt;Private subnet AZ-a&lt;/b&gt;&lt;br&gt;10.20.32.0/20&lt;br&gt;&lt;br&gt;Typical placement:&lt;br&gt;• Master (control plane)&lt;br&gt;• worker-1&lt;br&gt;• Jenkins&lt;br&gt;• Sonar / Nexus (lab)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="580" width="260" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="pr2" value="&lt;b&gt;Private subnet AZ-b&lt;/b&gt;&lt;br&gt;10.20.48.0/20&lt;br&gt;&lt;br&gt;• worker-2 (second AZ)&lt;br&gt;• Extra private capacity&lt;br&gt;&lt;br&gt;Same private RTs → NAT" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="580" width="240" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="sg" value="&lt;b&gt;SECURITY GROUPS (Terraform)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;nginx&lt;/b&gt; — 22,80,443 world&lt;br&gt;&lt;b&gt;cluster&lt;/b&gt; — 22,80,443,6443, NodePort 30000–32767, kubelet 10250–10259, Calico BGP 179 + IPIP + VXLAN — from VPC CIDR&lt;br&gt;&lt;b&gt;jenkins&lt;/b&gt; — 8080, 50000 from VPC&lt;br&gt;&lt;b&gt;sonar&lt;/b&gt; — 9000 from VPC&lt;br&gt;&lt;b&gt;nexus&lt;/b&gt; — 8081 from VPC" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="580" width="400" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="iam" value="&lt;b&gt;IAM / SSM&lt;/b&gt;&lt;br&gt;&lt;br&gt;module iam-ssm&lt;br&gt;Instance profile on ALL nodes&lt;br&gt;user_data installs SSM agent&lt;br&gt;&lt;br&gt;Admin: aws ssm start-session&lt;br&gt;(no need for public SSH on private nodes)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1110" y="580" width="360" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="why" value="&lt;b&gt;Why this shape?&lt;/b&gt; One public choke-point (Nginx) reduces attack surface and cost. Private nodes pull packages via NAT. Calico needs BGP/IPIP between cluster nodes — hence cluster SG allows VPC CIDR for CNI. Ansible discovers nodes by tags Role + Ansible=true + Project=scopify-cluster." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="790" width="1350" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-ec2" name="3. EC2 Roles">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="e0" value="EC2 INVENTORY — what Terraform builds &amp; why each exists" style="text;html=1;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1480" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e0b" value="Default size c7i-flex.large · Ubuntu AMI · gp3 roots · tags: Role=&lt;key&gt;, Ansible=true, Project=scopify-cluster" style="text;html=1;align=center;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="55" width="1480" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="n1" value="&lt;b&gt;nginx&lt;/b&gt; (public · t3.small · 20GB)&lt;br&gt;&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; Sole internet-facing host. Reverse proxy + TLS termination + SSH jump / ProxyJump.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ansible:&lt;/b&gt; site-nginx.yml → Docker nginx:1.27-alpine, bind-mount /opt/scopify-nginx/conf.d, Certbot DNS-01 wildcard, proxies Host headers to private IPs.&lt;br&gt;&lt;br&gt;&lt;b&gt;DNS:&lt;/b&gt; EIP is A-record target for jenkins/sonar/nexus/api/test-k8s." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="480" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="n2" value="&lt;b&gt;master&lt;/b&gt; (private · control plane)&lt;br&gt;&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; Kubernetes brain — API server :6443, etcd, scheduler, controller-manager.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ansible:&lt;/b&gt; site.yml → common + master. kubeadm init, Calico CNI, Ingress-Nginx, join token, kubeconfig for ubuntu.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ops:&lt;/b&gt; Run kubectl here (or via copied kubeconfig on Jenkins)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="480" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="n3" value="&lt;b&gt;worker-1 / worker-2&lt;/b&gt; (private · data plane)&lt;br&gt;&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; Run application / ingress / CNI pods. Two workers for scheduling room + multi-AZ practice.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ansible:&lt;/b&gt; site.yml → common + workers. kubeadm join using master’s token.&lt;br&gt;&lt;br&gt;&lt;b&gt;Note:&lt;/b&gt; No etcd/API. kubectl on worker without kubeconfig fails (normal)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="100" width="480" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="n4" value="&lt;b&gt;jenkins&lt;/b&gt; (private · CI/CD)&lt;br&gt;&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; Build pipelines (checkout → test → image → deploy). Stays on dedicated EC2 (frozen arch).&lt;br&gt;&lt;br&gt;&lt;b&gt;Ansible:&lt;/b&gt; site-tools.yml → Jenkins Docker, Trivy, kubectl pinned to master version, kubeconfig copied from master for CD.&lt;br&gt;&lt;br&gt;&lt;b&gt;URL:&lt;/b&gt; https://jenkins.ashmit.xyz → Nginx → :8080" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="480" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="n5" value="&lt;b&gt;sonar&lt;/b&gt; (private · quality — temporary EC2)&lt;br&gt;&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; Code quality scans for CI. On EC2 for lab speed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ansible:&lt;/b&gt; site-tools.yml → SonarQube Docker :9000.&lt;br&gt;&lt;br&gt;&lt;b&gt;Target:&lt;/b&gt; Move into Kubernetes + PVC later; retire this EC2." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#E0E7FF;strokeColor=#4F46E5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="350" width="480" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="n6" value="&lt;b&gt;nexus&lt;/b&gt; (private · artifacts — temporary EC2)&lt;br&gt;&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; Artifact / Docker registry for builds.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ansible:&lt;/b&gt; site-tools.yml → Nexus Docker :8081.&lt;br&gt;&lt;br&gt;&lt;b&gt;Target:&lt;/b&gt; In-cluster Nexus + PVC; Jenkins pushes images there." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FCE7F3;strokeColor=#DB2777;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="350" width="480" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="order" value="&lt;b&gt;Bring-up order&lt;/b&gt;&lt;br&gt;1) terraform apply → VPC + 7 EC2 + EIP + SSM&lt;br&gt;2) ansible-playbook site.yml → K8s Ready&lt;br&gt;3) site-tools.yml → Jenkins/Sonar/Nexus (+ Jenkins kubectl)&lt;br&gt;4) site-nginx.yml → edge proxy + wildcard TLS&lt;br&gt;5) Cloudflare A records → Nginx EIP&lt;br&gt;6) Deploy apps into K8s; point api/test hosts at Ingress NodePort" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="720" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="tags" value="&lt;b&gt;Inventory mapping (ansible/inventories/aws_ec2.yml)&lt;/b&gt;&lt;br&gt;Role=nginx → group nginx / edge&lt;br&gt;Role=master → group master / k8s&lt;br&gt;Role=worker-* → group workers / k8s&lt;br&gt;Role=jenkins|sonar|nexus → group tools&lt;br&gt;private = all non-nginx · Ansible SSH ProxyJump via nginx automatically" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="600" width="720" height="180" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-k8s" name="4. Kubernetes Bootstrap">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="k0" value="KUBERNETES — how it is deployed &amp; connected (Ansible site.yml)" style="text;html=1;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1480" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="k0b" value="Versions pinned in group_vars/all.yml: Kubernetes 1.35.6 · Calico v3.32.1 · Ingress-Nginx controller-v1.15.1 · pod CIDR 10.244.0.0/16" style="text;html=1;align=center;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="55" width="1480" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="p1" value="&lt;b&gt;PLAY 1 — common&lt;/b&gt;&#xa;(master + workers)&lt;br&gt;&lt;br&gt;• Disable swap&lt;br&gt;• br_netfilter + ip_forward&lt;br&gt;• containerd (SystemdCgroup)&lt;br&gt;• kubeadm / kubelet / kubectl 1.35.6 (held)&lt;br&gt;• Docker also for tools hosts when needed&lt;br&gt;• ssm_login role" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="300" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;PLAY 2 — master&lt;/b&gt;&#xa;(control plane only)&lt;br&gt;&lt;br&gt;1. Pre-pull control-plane images&lt;br&gt;2. kubeadm init (skip CoreDNS/kube-proxy first, then install)&lt;br&gt;3. Copy admin.conf → ubuntu kubeconfig&lt;br&gt;4. Wait API :6443 ready&lt;br&gt;5. Apply Calico manifest&lt;br&gt;6. Apply Ingress-Nginx baremetal&lt;br&gt;7. Print join command" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="100" width="360" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;PLAY 3 — workers&lt;/b&gt;&#xa;(data plane)&lt;br&gt;&lt;br&gt;• Read join command from master hostvars&lt;br&gt;• kubeadm join&lt;br&gt;• kubelet registers node&lt;br&gt;• Ready once Calico healthy&lt;br&gt;&lt;br&gt;Idempotent: skip if kubelet.conf exists" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="100" width="320" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;DAY-2 — tools + edge&lt;/b&gt;&lt;br&gt;&lt;br&gt;site-tools.yml:&lt;br&gt;Jenkins + kubectl + master kubeconfig&lt;br&gt;Sonar + Nexus Docker&lt;br&gt;&lt;br&gt;site-nginx.yml:&lt;br&gt;Edge proxy to private IPs&lt;br&gt;Wildcard LE cert via Cloudflare" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="100" width="340" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="cluster" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0F172A;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="1440" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="cl" value="CLUSTER INTERNALS — after site.yml succeeds" style="text;html=1;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="385" width="500" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="cp" value="&lt;b&gt;CONTROL PLANE (Master EC2)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Static pods (kubeadm):&lt;br&gt;• kube-apiserver :6443&lt;br&gt;• etcd&lt;br&gt;• controller-manager&lt;br&gt;• scheduler&lt;br&gt;&lt;br&gt;Addons:&lt;br&gt;• CoreDNS&lt;br&gt;• kube-proxy&lt;br&gt;&lt;br&gt;You → kubectl → API → schedule pods" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="430" width="320" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="cni" value="&lt;b&gt;CNI — Calico v3.32.1&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gives every pod an IP in 10.244.0.0/16&lt;br&gt;Routes pod↔pod across nodes&lt;br&gt;Default: BGP + IPIP (Always)&lt;br&gt;&lt;br&gt;Needs SG: TCP 179, protocol 4 (IPIP), optional UDP 4789&lt;br&gt;&lt;br&gt;Without Calico → nodes NotReady" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#E0E7FF;strokeColor=#4F46E5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="430" width="320" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="ing" value="&lt;b&gt;INGRESS — NGINX Ingress v1.15.1&lt;/b&gt;&lt;br&gt;&lt;br&gt;Namespace: ingress-nginx&lt;br&gt;Baremetal provider → NodePort&lt;br&gt;&lt;br&gt;In-cluster HTTP routing by Host&lt;br&gt;(api.ashmit.xyz → Service)&lt;br&gt;&lt;br&gt;Edge Nginx proxies selected hosts to this NodePort on a worker/master private IP" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="430" width="340" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="dp" value="&lt;b&gt;DATA PLANE (Workers)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Each worker runs:&lt;br&gt;• kubelet&lt;br&gt;• containerd (CRI)&lt;br&gt;• Calico node agent&lt;br&gt;• Scheduled pods&lt;br&gt;&lt;br&gt;Apps (test / Scopify API later) land here as Deployments + Services" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="430" width="310" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="conn" value="&lt;b&gt;How pieces connect&lt;/b&gt;  Workers join Master API (:6443 over VPC). Calico meshes pod networks across nodes. Ingress Controller watches Ingress objects and opens NodePorts. Jenkins (separate EC2) holds a copy of master kubeconfig so pipelines can kubectl apply. Edge Nginx (public) still terminates TLS for humans; it forwards Host-matched traffic either to tool EC2 ports or to Ingress NodePort." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#ECFDF5;strokeColor=#059669;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="730" width="1380" height="90" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-traffic" name="5. Traffic &amp; K8s Contents">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t0" value="TRAFFIC MAP + WHAT IS / WILL BE INSIDE KUBERNETES" style="text;html=1;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1480" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="path" value="&lt;b&gt;PUBLIC PATH&lt;/b&gt;&lt;br&gt;Browser → Cloudflare (DNS) → Nginx EIP :443 → Host header decide&lt;br&gt;• jenkins.ashmit.xyz → Jenkins private IP:8080&lt;br&gt;• sonar.ashmit.xyz → Sonar private IP:9000&lt;br&gt;• nexus.ashmit.xyz → Nexus private IP:8081&lt;br&gt;• test-k8s / api (when wired) → Ingress NodePort on K8s node → Service → Pod&lt;br&gt;&lt;br&gt;&lt;b&gt;ADMIN PATH&lt;/b&gt;&lt;br&gt;Laptop → AWS SSM Session Manager → any EC2 (ubuntu)&lt;br&gt;OR SSH ubuntu@Nginx-EIP → ProxyJump → private EC2" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="740" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="tls" value="&lt;b&gt;TLS&lt;/b&gt;&lt;br&gt;Certbot on Nginx host&lt;br&gt;Method: dns-cloudflare (DNS-01)&lt;br&gt;Names: ashmit.xyz + *.ashmit.xyz&lt;br&gt;Token: ansible/group_vars/nginx_secrets.yml&lt;br&gt;Live certs: /etc/letsencrypt (bind-mounted RO into nginx container)&lt;br&gt;Config host path: /opt/scopify-nginx/conf.d/default.conf" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="80" width="670" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="in-k8s" value="&lt;b&gt;ALREADY ON THE CLUSTER (Ansible-installed platform)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• kube-system: API, etcd, scheduler, controller-manager, CoreDNS, kube-proxy&lt;br&gt;• Calico (CNI pods / DaemonSet)&lt;br&gt;• ingress-nginx namespace: Ingress Controller (NodePort)&lt;br&gt;• Your lab test app (manual) proving Host routing via Ingress&lt;br&gt;&lt;br&gt;&lt;b&gt;NOT YET IN REPO as managed manifests (planned)&lt;/b&gt;&lt;br&gt;• Scopify API (NestJS) Deployment/Service/Ingress → api.ashmit.xyz&lt;br&gt;• Postgres + Redis for API&lt;br&gt;• Sonar / Nexus Helm + PVC (retire EC2s)&lt;br&gt;• Prometheus / Grafana / Argo CD" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#ECFDF5;strokeColor=#059669;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="740" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="ci" value="&lt;b&gt;CI/CD WIRING (current → target)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Now:&lt;/b&gt; Jenkins EC2 has Docker + kubectl + master kubeconfig. Starter Jenkinsfile in repo root (checkout + echo testing). Backend image builds via GitHub Actions → GHCR (ghcr.io/ashmit-gupta/scopify-backend).&lt;br&gt;&lt;br&gt;&lt;b&gt;Next:&lt;/b&gt; Jenkins pipeline build/push → kubectl apply (or Argo sync). Nginx route api.ashmit.xyz → Ingress. Secrets via kubectl Secret / sealed secrets — never git." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#FDF2F8;strokeColor=#DB2777;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="340" width="670" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="sum" value="&lt;b&gt;ONE-LINE SUMMARY&lt;/b&gt;&lt;br&gt;Terraform builds the AWS skeleton (VPC, subnets, SG, 7 EC2, EIP, SSM). Ansible paints the software (kubeadm cluster + Calico + Ingress, tool VMs, Nginx edge + wildcard TLS). Cloudflare points humans at Nginx. Private workloads never need public IPs. Kubernetes is the future home for Scopify API (and later Sonar/Nexus/observability); Jenkins stays on its own EC2 as the CI brain." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#0F172A;fontColor=#F8FAFC;strokeColor=#0F172A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="1440" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="files" value="Key files: terraform/terraform.tfvars · terraform/modules/vpc · ansible/site.yml · ansible/site-tools.yml · ansible/site-nginx.yml · ansible/group_vars/all.yml · ansible/roles/master · ARCHITECTURE.md · IMPLEMENTATION_PLAN.md" style="text;html=1;align=center;fontSize=11;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="60" y="800" width="1440" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
